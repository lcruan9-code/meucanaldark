        }
      ],
      "narration": {
        "src": "narration/ai-gold-rush/sc01.mp3",
        "text": "Deep inside an unmarked concrete facility in Northern Virginia, thirty thousand processors hum in unison. From the outside, the building resembles an anonymous logistics warehouse, surrounded by barbed wire, security checkpoints, and massive diesel backup generators.",
        "gainDb": 0
      }
    },
    {
      "id": "sc02",
      "chapterId": "ch1",
      "transitionIn": {
        "type": "fade",
        "duration": 0.6
      },
      "note": "",
      "layers": [
        {
          "component": "backdrop",
          "track": "background",
          "props": {
            "glow": "",
            "gridSize": 96
          }
        },
        {
          "component": "world-map",
          "track": "main",
          "camera": {
            "fromScale": 1,
            "toScale": 1.25,
            "originX": 0.32,
            "originY": 0.38
          },
          "props": {
