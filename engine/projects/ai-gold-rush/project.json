          "props": {
            "primary": "Loudoun County, Virginia",
            "secondary": "Capital of Global Internet Infrastructure"
          }
        }
      ],
      "narration": {
        "src": "narration/ai-gold-rush/sc02.mp3",
        "text": "But inside, these halls pulse with the digital thoughts, generated synthetic media, and reasoning engines for hundreds of millions of people across the planet. This region, Loudoun County, is often called Data Center Alley.",
        "gainDb": 0
      }
    },
    {
      "id": "sc03",
      "chapterId": "ch1",
      "transitionIn": {
        "type": "dip-to-black",
        "duration": 0.8
      },
      "note": "",
      "layers": [
        {
          "component": "data-center-3d",
          "track": "background",
          "props": {
            "shot": "aisle",
            "seed": 7,
            "pulse": true
          }
        },
        {
          "component": "callout",
          "track": "overlay",
          "from": 2.5,
          "duration": 12,
          "props": {
            "kicker": "70% of Global Traffic",
            "text": "Over 25 million square feet of hyperscale data centers operational in a single county.",
            "position": "bottom-left"
          }
        }
      ],
      "narration": {
        "src": "narration/ai-gold-rush/sc03.mp3",
        "text": "More than seventy percent of the world's daily internet traffic flows through these windowless structures. In less than three decades, quiet farmland has been transformed into the densest concentration of computing power ever assembled in human history.",
        "gainDb": 0
      }
    },
    {
      "id": "sc04",
      "chapterId": "ch1",
      "transitionIn": {
        "type": "cross-zoom",
        "duration": 0.7
      },
      "note": "",
      "layers": [
        {
          "component": "backdrop",
          "track": "background",
          "props": {
            "glow": "",
            "gridSize": 0
          }
        },
        {
          "component": "kinetic-text",
          "track": "main",
          "props": {
            "text": "Artificial intelligence did *not* descend from a cloud. It took root in concrete.",
            "size": 60
          }
        }
      ],
      "narration": {
        "src": "narration/ai-gold-rush/sc04.mp3",
        "text": "When modern artificial intelligence arrived, it did not descend from an ethereal cloud. It took root in these concrete foundations, demanding more electricity, more cold water, and more physical silicon than any previous technological revolution.",
        "gainDb": 0
      }
    },
    {
      "id": "sc05",
      "chapterId": "ch1",
      "transitionIn": {
        "type": "fade",
        "duration": 0.6
      },
      "note": "",
      "layers": [
        {
          "component": "backdrop",
          "track": "background",
          "props": {
            "glow": ""
          }
        },
        {
          "component": "bar-chart",
          "track": "main",
          "props": {
            "title": "Days Required to Reach 100 Million Users",
            "bars": [
              {
                "label": "ChatGPT",
                "value": 60,
                "highlight": true
              },
              {
                "label": "TikTok",
                "value": 270
              },
              {
                "label": "Instagram",
                "value": 910
              },
              {
                "label": "Spotify",
                "value": 1278
