          }
        }
      ],
      "narration": {
        "src": "narration/ai-gold-rush/sc05.mp3",
        "text": "When ChatGPT launched in late 2022, it crossed one hundred million monthly active users in just sixty days. By comparison, it took Instagram two and a half years, and Spotify more than three years to reach that same threshold.",
        "gainDb": 0
      }
    },
    {
      "id": "sc06",
      "chapterId": "ch1",
      "transitionIn": {
        "type": "dip-to-black",
        "duration": 0.8
      },
      "note": "",
      "layers": [
        {
          "component": "backdrop",
          "track": "background",
