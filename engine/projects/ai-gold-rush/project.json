            "glow": ""
          }
        },
        {
          "component": "world-map",
          "track": "main",
          "props": {
            "showBorders": true,
            "routes": [
              {
                "from": "new-york",
                "to": "london",
                "startAt": 0.05,
                "growth": 0.35
              },
              {
                "from": "fortaleza",
                "to": "lisbon",
                "startAt": 0.2,
