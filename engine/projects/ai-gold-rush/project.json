            ]
          }
        }
      ],
      "narration": {
        "src": "narration/ai-gold-rush/sc13.mp3",
        "text": "Within this tight vertical enclosure, processors exchange intermediate mathematical tensors at over nine hundred gigabytes per second. If the network experiences even microsecond-level latency or packet drops, thousands of interconnected chips stall, wasting thousands of dollars of compute time every minute.",
        "gainDb": 0
      }
    },
    {
      "id": "sc14",
      "chapterId": "ch3",
      "transitionIn": {
        "type": "dip-to-black",
        "duration": 0.9
      },
      "note": "",
      "layers": [
        {
          "component": "backdrop",
          "track": "background",
          "props": {
            "glow": "",
            "gridSize": 0
          }
        },
        {
          "component": "kinetic-text",
          "track": "main",
          "props": {
            "text": "The most *capital-intensive* machine in human civilization.",
            "size": 62
          }
        }
      ],
      "narration": {
        "src": "narration/ai-gold-rush/sc14.mp3",
        "text": "These machines represent the most complex and capital-intensive manufacturing achievement in human civilization. And they are completely dependent on an unbroken stream of physical resources.",
        "gainDb": 0
      }
    },
    {
      "id": "sc15",
      "chapterId": "ch4",
      "transitionIn": {
        "type": "fade",
        "duration": 0.6
