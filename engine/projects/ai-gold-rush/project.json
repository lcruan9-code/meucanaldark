            "source": "Global Network Latency Telemetry"
          }
        }
      ],
      "narration": {
        "src": "narration/ai-gold-rush/sc10.mp3",
        "text": "This entire round trip—from your fingers, through thousands of miles of glass fiber, into the silicon die, and back to your screen—takes less than three hundred milliseconds.",
        "gainDb": 0
      }
    },
    {
      "id": "sc11",
      "chapterId": "ch3",
      "transitionIn": {
        "type": "dip-to-black",
        "duration": 0.8
      },
      "note": "",
      "layers": [
        {
          "component": "data-center-3d",
          "track": "background",
          "props": {
            "shot": "rack",
            "seed": 11,
            "pulse": false
          }
        },
        {
          "component": "lower-third",
          "track": "overlay",
          "from": 2,
          "duration": 10,
          "props": {
            "primary": "Hyperscale Compute Rack",
            "secondary": "8x Accelerated Processing Units with NVLink Fabric"
          }
        }
      ],
      "narration": {
        "src": "narration/ai-gold-rush/sc11.mp3",
        "text": "The basic unit of modern artificial intelligence is no longer the server. It is the high-density computing rack. Inside each vertical chassis sits a cluster of eight specialized graphics processing units, interconnected by proprietary high-speed copper and optical links.",
        "gainDb": 0
      }
    },
    {
      "id": "sc12",
      "chapterId": "ch3",
      "transitionIn": {
        "type": "fade",
        "duration": 0.6
      },
      "note": "",
      "layers": [
        {
          "component": "backdrop",
          "track": "background",
          "props": {
            "glow": ""
          }
        },
        {
          "component": "stat-block",
          "track": "main",
          "props": {
            "eyebrow": "Power Density Surge",
            "locale": "en-US",
            "stats": [
              {
                "value": 40,
                "suffix": " kW",
                "label": "per single rack"
              },
              {
                "value": 32,
                "label": "homes powered equivalent"
              },
              {
                "value": 1.2,
                "suffix": " m²",
                "decimals": 1,
                "label": "physical footprint"
              }
            ],
            "source": "Uptime Institute Data Center Survey"
          }
        }
      ],
      "narration": {
        "src": "narration/ai-gold-rush/sc12.mp3",
        "text": "A single modern AI server rack draws over forty kilowatts of continuous electricity. That is enough electrical energy to power more than thirty average American homes simultaneously, concentrated entirely within a footprint smaller than a standard refrigerator.",
        "gainDb": 0
      }
    },
    {
      "id": "sc13",
      "chapterId": "ch3",
      "transitionIn": {
        "type": "cross-zoom",
        "duration": 0.6
      },
      "note": "",
      "layers": [
        {
          "component": "backdrop",
          "track": "background",
          "props": {
            "glow": ""
          }
        },
        {
          "component": "bar-chart",
          "track": "main",
          "props": {
            "title": "Interconnect Bandwidth (GB/s)",
            "bars": [
              {
                "label": "NVLink Switch Fabric",
                "value": 900,
                "highlight": true
              },
              {
                "label": "PCIe Gen 5 x16",
                "value": 128
              },
              {
                "label": "InfiniBand Quantum",
                "value": 50
              },
              {
                "label": "10 Gigabit Ethernet",
                "value": 1
