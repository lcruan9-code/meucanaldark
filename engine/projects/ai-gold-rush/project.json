      "narration": {
        "src": "narration/ai-gold-rush/sc08.mp3",
        "text": "It is converted into mathematical token vectors and launched across the global grid. In less than fifty milliseconds, your data travels through underground fiber optic conduits, passes through carrier-neutral internet exchanges, and arrives at the security perimeter of a hyperscale computing campus.",
        "gainDb": 0
      }
    },
    {
      "id": "sc09",
      "chapterId": "ch2",
