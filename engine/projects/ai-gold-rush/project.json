      ],
      "narration": {
        "src": "narration/ai-gold-rush/sc18.mp3",
        "text": "On peak summer afternoons, a single hyperscale campus can evaporate millions of gallons of water every day just to prevent its processors from melting. The ethereal mind of artificial intelligence is bound directly to the municipal water supply.",
        "gainDb": 0
      }
    },
    {
      "id": "sc19",
      "chapterId": "ch4",
      "transitionIn": {
        "type": "dip-to-black",
        "duration": 0.8
      },
      "note": "",
      "layers": [
        {
          "component": "backdrop",
          "track": "background",
          "props": {
            "glow": "",
            "gridSize": 0
          }
        },
        {
          "component": "kinetic-text",
          "track": "main",
          "props": {
            "text": "Every computing cluster is fundamentally a *thermal machine*.",
            "size": 60
          }
        }
      ],
      "narration": {
        "src": "narration/ai-gold-rush/sc19.mp3",
        "text": "Every computing cluster is fundamentally a thermal machine, constrained not by human ambition, but by how fast boiling heat can be rejected into the surrounding atmosphere.",
        "gainDb": 0
      }
    },
