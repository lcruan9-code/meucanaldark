      "narration": {
        "src": "narration/ai-gold-rush/sc09.mp3",
        "text": "Inside the facility, high-throughput network switches route the packet directly to a synchronized GPU cluster. Two entirely different computational worlds exist here: the training cluster, where colossal frontier models spend months learning from trillions of tokens, and the inference cluster, where billions of individual daily queries are answered in fractions of a second.",
        "gainDb": 0
      }
    },
    {
      "id": "sc10",
      "chapterId": "ch2",
      "transitionIn": {
        "type": "fade",
        "duration": 0.5
      },
      "note": "",
      "layers": [
        {
          "component": "backdrop",
          "track": "background",
          "props": {
            "glow": ""
          }
        },
        {
          "component": "stat-block",
          "track": "main",
          "props": {
            "eyebrow": "Speed of Thought",
            "locale": "en-US",
            "stats": [
              {
                "value": 300,
                "suffix": " ms",
