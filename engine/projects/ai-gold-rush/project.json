      ],
      "narration": {
        "src": "narration/ai-gold-rush/sc17.mp3",
        "text": "To survive thermal collapse, data centers are re-engineering their entire internal plumbing. High-purity chilled liquid must be pumped directly across copper cold plates mounted to the silicon surface, carrying megawatts of heat away to massive external cooling towers.",
        "gainDb": 0
      }
    },
    {
      "id": "sc18",
      "chapterId": "ch4",
      "transitionIn": {
        "type": "fade",
        "duration": 0.6
      },
      "note": "",
      "layers": [
        {
          "component": "backdrop",
          "track": "background",
          "props": {
            "glow": ""
          }
        },
        {
