          }
        }
      ],
      "narration": {
        "src": "narration/ai-gold-rush/sc06.mp3",
        "text": "The world had never adopted a consumer technology with such ferocious speed, catching global telecommunications and electric grid infrastructure entirely unprepared.",
        "gainDb": 0
      }
    },
    {
      "id": "sc07",
      "chapterId": "ch2",
      "transitionIn": {
        "type": "fade",
        "duration": 0.6
      },
      "note": "",
      "layers": [
        {
          "component": "backdrop",
          "track": "background",
          "props": {
            "glow": "",
            "gridSize": 64
          }
        },
        {
          "component": "kinetic-text",
          "track": "main",
          "props": {
            "text": "Your prompt does *not* stay on your phone. It moves across the earth.",
            "size": 58
          }
        }
      ],
      "narration": {
        "src": "narration/ai-gold-rush/sc07.mp3",
        "text": "To understand where this power comes from, follow the physical path of a single query. When you type a question into an artificial intelligence model, your prompt does not rest inside your phone or your browser.",
        "gainDb": 0
      }
    },
    {
      "id": "sc08",
      "chapterId": "ch2",
      "transitionIn": {
        "type": "cross-zoom",
        "duration": 0.7
      },
      "note": "",
      "layers": [
        {
          "component": "backdrop",
          "track": "background",
